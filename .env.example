# Copy this file to .env and change the values.  NEVER commit your real .env file.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env

# development | production  (production refuses to start without real API keys)
APP_ENV=development

# Role-based access control:
#   no key       -> viewer  (read-only dashboards)
#   ANALYST key  -> analyst (add notes, change alert/threat status)
#   ADMIN key    -> admin   (create threats, edit names/descriptions)
# Generate strong values, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ANALYST_API_KEY=change-me-analyst-key
ADMIN_API_KEY=change-me-admin-key

# Optional overrides
# DATABASE_PATH=data/threat_intel.db
# PORT=5000
RATE_LIMIT_PER_MINUTE=300
ALERT_RISK_THRESHOLD=61
ALERT_CONFIDENCE_THRESHOLD=60
REPEATED_OBSERVATION_THRESHOLD=50
CORRELATION_WINDOW_MINUTES=60

# Future, OPTIONAL integrations (not required - the project works fully offline).
# Only ever use authorised, defensive threat-intel APIs, and keep keys here, not in code.
# THREAT_FEED_API_KEY=
